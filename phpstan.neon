includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # A ratchet for new code, not a mandate to rewrite the package. Everything
    # the level cannot see today sits in the baseline and has to shrink, never
    # grow.
    level: 5

    paths:
        - src
        - database
        - config
        - routes

    # The activity bridge references classes from an optional sibling addon
    # (`suggest`, guarded by class_exists). Those classes are legitimately absent
    # in a bare install, so analysing the file would report every reference as
    # unknown.
    excludePaths:
        - src/Bridges/ActivityBridge.php

    # The metrics under src/Integrations/Insights implement the analytics
    # addon's contract and extend its base class. That addon is a `suggest`, not
    # a requirement, so it is not in vendor — and the files would otherwise be
    # reported as a heap of unknown classes.
    #
    # Scanned from the test stand-ins rather than excluded like the bridge above:
    # the stand-ins are the same declarations, byte for byte
    # (InsightsContractsMatchTest holds them to that), so the metrics are
    # analysed against the real signatures instead of not being analysed at all.
    # Scanned, not analysed: the files themselves are not code this package
    # ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

    treatPhpDocTypesAsCertain: false
